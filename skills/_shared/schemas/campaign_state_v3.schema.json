{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campaign state v3",
  "type": "object",
  "required": ["schema_version", "kind", "campaign_id", "ledger_ref", "authorization_ref", "profile_ref", "items", "active_run", "state_revision"],
  "properties": {
    "schema_version": {"const": 3},
    "kind": {"const": "campaign_state"},
    "campaign_id": {"type": "string", "minLength": 1},
    "ledger_ref": {"$ref": "#/$defs/file_ref"},
    "authorization_ref": {"$ref": "#/$defs/file_ref"},
    "profile_ref": {"$ref": "#/$defs/file_ref"},
    "items": {"type": "object", "minProperties": 1},
    "active_run": {"type": ["object", "null"]},
    "state_revision": {"type": "integer", "minimum": 0}
  },
  "$defs": {"file_ref": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
