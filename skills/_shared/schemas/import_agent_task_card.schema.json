{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo://skills/_shared/schemas/import_agent_task_card.schema.json",
  "title": "LLMWiki import one-shot agent task card v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "batch_id", "attempt_id", "attempt_no", "worker_instance_id", "fork_context", "queue_ref", "queue_ordinal", "owner_skill", "agent_role", "payload_class", "batch_metrics", "input_refs", "result_path"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"$ref": "#/$defs/id"},
    "batch_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "attempt_no": {"enum": [1, 2]},
    "retry_of": {"$ref": "#/$defs/id"},
    "worker_instance_id": {"$ref": "#/$defs/id"},
    "fork_context": {"const": false},
    "queue_ref": {"$ref": "#/$defs/hashPathRef"},
    "queue_ordinal": {"type": "integer", "minimum": 0},
    "owner_skill": {"$ref": "#/$defs/ownerSkill"},
    "agent_role": {"enum": ["reviewer", "executor", "verifier"]},
    "payload_class": {"type": "string", "minLength": 1, "maxLength": 64},
    "batch_metrics": {"$ref": "#/$defs/batchMetrics"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "input_refs": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/hashPathRef"}},
    "write_targets": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/pathRef"}},
    "result_path": {"$ref": "#/$defs/pathRef"},
    "instructions": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"attempt_no": {"const": 1}}, "required": ["attempt_no"]},
      "then": {"not": {"required": ["retry_of"]}}
    },
    {
      "if": {"properties": {"attempt_no": {"const": 2}}, "required": ["attempt_no"]},
      "then": {"required": ["retry_of"]}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "ownerSkill": {"enum": ["bemarkdown", "chinese-handwriting-formula-transcriber", "textbook-import", "standards-import", "exercise-bank-import", "student-data-import", "video-transcript-import"]},
    "pathRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_id", "relative_path"],
      "properties": {
        "path_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "hashPathRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_id", "relative_path", "sha256", "size_bytes"],
      "properties": {
        "path_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "batchMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_count", "page_count", "unresolved_review_blocks"],
      "properties": {
        "item_count": {"type": "integer", "minimum": 0},
        "page_count": {"type": "integer", "minimum": 0},
        "unresolved_review_blocks": {"type": "integer", "minimum": 0}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deidentified", "contains_raw_private_payload"],
      "properties": {
        "deidentified": {"type": "boolean"},
        "contains_raw_private_payload": {"const": false}
      }
    }
  }
}
