{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apply receipt v3",
  "type": "object",
  "required": ["schema_version", "kind", "status", "campaign_id", "batch_id", "run_id", "question_id", "authorization_sha256", "files", "validations"],
  "properties": {
    "schema_version": {"const": 3},
    "kind": {"const": "apply_receipt"},
    "status": {"const": "applied"},
    "campaign_id": {"type": "string"},
    "batch_id": {"type": "string"},
    "run_id": {"type": "string"},
    "question_id": {"type": "string"},
    "authorization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {"type": "array", "minItems": 1},
    "validations": {"type": "object", "required": ["ok"], "properties": {"ok": {"const": true}}}
  }
}
